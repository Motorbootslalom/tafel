{
  "name": "tafel-relais",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-01",

  // Registriert die Klasse. "storage": "sqlite" ist im kostenlosen Tarif
  // Pflicht – die Schlüssel-Wert-Ablage gibt es dort nicht. Ältere Anleitungen
  // zeigen dafür einen "migrations"-Block mit "new_sqlite_classes"; beides
  // beschreibt dasselbe.
  "exports": {
    "Raum": { "type": "durable-object", "storage": "sqlite" }
  },

  "durable_objects": {
    "bindings": [{ "name": "RAUM", "class_name": "Raum" }]
  },

  // Die workers.dev-Adresse ist die, die in der Verwaltung eingetragen wird –
  // also ausdrücklich an. Ohne diese Zeile wäre sie zwar auch an, aber Wrangler
  // warnt bei jedem Ausrollen, dass es eine Vorgabe ist.
  "workers_dev": true,

  // Vorschau-Adressen dagegen aus: Sie ergäben je Fassung eine weitere
  // öffentliche Adresse auf dasselbe Relais. Für einen Dienst, dessen einziger
  // Schutz ein Schlüssel ist, ist jede zusätzliche Adresse eine zu viel – und
  // gebraucht wird hier ohnehin nur die eine.
  "preview_urls": false

  // Der Host-Schlüssel gehört nicht hierher, sondern daneben:
  //   npx wrangler secret put HOST_KEY
}
