{
  "name": "tafel-relais",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-01",

  // Registriert die Klasse. "storage": "sqlite" ist im kostenlosen Tarif
  // Pflicht – die Schlüssel-Wert-Ablage gibt es dort nicht. Ältere Anleitungen
  // zeigen dafür einen "migrations"-Block mit "new_sqlite_classes"; beides
  // beschreibt dasselbe.
  "exports": {
    "Raum": { "type": "durable-object", "storage": "sqlite" }
  },

  "durable_objects": {
    "bindings": [{ "name": "RAUM", "class_name": "Raum" }]
  }

  // Der Host-Schlüssel gehört nicht hierher, sondern daneben:
  //   npx wrangler secret put HOST_KEY
}
