{
  "name": "tafel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Anzeigetafel und Startlisten-Steuerung für den Motorbootslalom",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:single": "vue-tsc -b && vite build --mode single",
    "build:all": "npm run build && npm run build:single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cloud": "node --test 'cloud/src/*.test.mjs' 'cloudflare/src/*.test.mjs'",
    "check": "vue-tsc -b && vitest run && npm run test:cloud",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "qrcode-generator": "^1.5.0",
    "vue": "^3.5.40",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
